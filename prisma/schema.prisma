generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
  STAFF
  ASSISTANT
}

enum AppointmentStatus {
  PENDING
  PENDING_DOCTOR_ACCEPTANCE
  ACCEPTED
  CONFIRMED
  AUTO_CANCELLED
  CANCELLED
  COMPLETED
  NO_SHOW
  RESCHEDULE_REQUESTED
  RESCHEDULED
  CANCELLATION_REQUESTED
  REFUND_PENDING
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  MERCADO_PAGO
  CASH
  TRANSFER
}

enum VerificationStatus {
  UNVERIFIED
  IN_REVIEW
  VERIFIED
  REJECTED
}

enum MedicalMedal {
  oro
  obsidiana
  diamante
  amatista
}

enum MedicalConversationStatus {
  OPEN
  CLOSED
}

enum SubscriptionStatus {
  FREE
  PENDING
  ACTIVE
  FAILED
  CANCELLED
}

enum MarketplaceListingType {
  MEDICAL_REPRESENTATIVE
  CATERING
}

enum MarketplaceListingStatus {
  PENDING
  ACTIVE
  INACTIVE
  REJECTED
}

enum MarketplacePlan {
  obsidiana
}

enum MarketplaceSubscriptionStatus {
  PENDING
  ACTIVE
  FAILED
  CANCELLED
}

enum ReviewStatus {
  PUBLISHED
  PENDING_REVIEW
  REJECTED
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  name                 String
  passwordHash         String
  role                 Role                  @default(PATIENT)
  isActive             Boolean               @default(true)
  patient              Patient?
  doctor               Doctor?
  assistant            DoctorAssistant?
  marketplaceListing   MarketplaceListing?
  auditLogs            AuditLog[]            @relation("AuditActor")
  sentMessages         MedicalChatMessage[]
  notifications        Notification[]
  passwordResetTokens  PasswordResetToken[]
  subscriptionPayments SubscriptionPayment[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Patient {
  id                       String         @id @default(cuid())
  userId                   String         @unique
  user                     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone                    String?
  dateOfBirth              DateTime?
  welcomeDiscountAvailable Boolean        @default(true)
  welcomeDiscountUsedAt    DateTime?
  appointments             Appointment[]
  cancellationRequests     CancellationRequest[]
  reviews                  DoctorReview[]
  clinicalHistories        ClinicalHistory[]
  prescriptions            Prescription[]
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
}

model Doctor {
  id                          String                @id @default(cuid())
  userId                      String?               @unique
  user                        User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName                    String
  slug                        String                @unique
  specialtyId                 String
  specialty                   Specialty             @relation(fields: [specialtyId], references: [id])
  hospitalId                  String
  hospital                    Hospital              @relation(fields: [hospitalId], references: [id])
  subSpecialty                String
  bio                         String
  yearsExperience             Int
  consultationPriceCents      Int
  consultationDurationMinutes Int                   @default(45)
  rating                      Float                 @default(4.9)
  imageUrl                    String?
  practicePhotoUrl            String?
  professionalLicensePhotoUrl String?
  university                  String?
  officeAddress               String?
  officeReference             String?
  cityState                   String?
  mapsUrl                     String?
  professionalPhone           String?
  instagramUrl                String?
  facebookUrl                 String?
  linkedinUrl                 String?
  websiteUrl                  String?
  whatsappUrl                 String?
  affiliateCodeLast4          String?
  affiliateDiscountEnabled    Boolean               @default(false)
  stripeAccountId             String?               @unique
  stripeOnboardingCompleted   Boolean               @default(false)
  payoutsEnabled              Boolean               @default(false)
  chargesEnabled              Boolean               @default(false)
  bankAccountLast4            String?
  achievements                String[]              @default([])
  certifications              String[]              @default([])
  legalDeclarationAccepted    Boolean               @default(false)
  medal                       MedicalMedal          @default(oro)
  subscriptionStatus          SubscriptionStatus    @default(FREE)
  isVerified                  Boolean               @default(false)
  verificationStatus          VerificationStatus    @default(UNVERIFIED)
  verifiedAt                  DateTime?
  professionalLicense         String?
  verification                MedicalVerification?
  availabilitySlots           AvailabilitySlot[]
  appointments                Appointment[]
  cancellationRequests        CancellationRequest[]
  conversationsCreated        MedicalConversation[] @relation("ConversationCreator")
  conversationsReceived       MedicalConversation[] @relation("ConversationRecipient")
  medicationSearchLogs        MedicationSearchLog[]
  reviews                     DoctorReview[]
  clinicalHistories           ClinicalHistory[]
  prescriptionTemplate        PrescriptionTemplate?
  prescriptions               Prescription[]
  additionalLocations         DoctorLocation[]
  assistants                  DoctorAssistant[]
  secretaryLink               DoctorSecretaryLink?
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt

  @@index([specialtyId, hospitalId, verificationStatus])
  @@index([medal, specialtyId, createdAt])
}

model Specialty {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  doctors     Doctor[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Hospital {
  id              String           @id @default(cuid())
  name            String           @unique
  city            String
  address         String?
  doctors         Doctor[]
  additionalDoctors DoctorLocation[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

/// Consultorios adicionales — un médico puede practicar en varios hospitales.
/// El hospital principal sigue en Doctor.hospitalId.
model DoctorLocation {
  id         String   @id @default(cuid())
  doctorId   String
  doctor     Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  notes      String?  // p.ej. "Consultorio 304, Torre B"
  createdAt  DateTime @default(now())

  @@unique([doctorId, hospitalId])
  @@index([doctorId])
  @@index([hospitalId])
}

model AvailabilitySlot {
  id                       String       @id @default(cuid())
  doctorId                 String
  doctor                   Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  startsAt                 DateTime
  endsAt                   DateTime
  isActive                 Boolean      @default(true)
  repeatBatchId            String?
  generatedByMonthlyRepeat Boolean      @default(false)
  repeatLabel              String?
  appointment              Appointment?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  @@unique([doctorId, startsAt])
  @@index([doctorId, startsAt, isActive])
  @@index([doctorId, repeatBatchId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

model SubscriptionPayment {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              MedicalMedal
  amountCents       Int
  currency          String          @default("mxn")
  status            PaymentStatus   @default(PENDING)
  provider          PaymentProvider @default(STRIPE)
  providerSessionId String?
  providerPaymentId String?
  providerCustomerId String?
  providerSubscriptionId String?
  currentPeriodEnd DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([userId, status, createdAt])
  @@index([providerSessionId])
  @@index([providerCustomerId])
  @@index([providerSubscriptionId])
}

model Appointment {
  id                  String            @id @default(cuid())
  patientId           String
  patient             Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorId            String
  doctor              Doctor            @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  availabilitySlotId  String            @unique
  availabilitySlot    AvailabilitySlot  @relation(fields: [availabilitySlotId], references: [id], onDelete: Restrict)
  status              AppointmentStatus @default(PENDING)
  reason              String?
  cancellationReason  String?
  requestedSlotId     String?
  acceptedAt          DateTime?
  acceptedByDoctor    Boolean           @default(false)
  acceptedAutomatically Boolean         @default(false)
  acceptedReason      String?
  completedAt         DateTime?
  noShowAt            DateTime?
  autoCancelledAt     DateTime?
  autoCancellationReason String?
  rescheduleRequestedAt DateTime?
  cancellationRequestedAt DateTime?
  refundRequestedAt   DateTime?
  cancellationRequested Boolean          @default(false)
  reschedulePreferred Boolean            @default(false)
  refundRequested     Boolean            @default(false)
  refundReason        String?
  doctorRefundDecision String?
  previousStartTime   DateTime?
  previousEndTime     DateTime?
  rescheduledAt       DateTime?
  originalAmountCents Int               @default(0)
  discountCents       Int               @default(0)
  discountLabel       String?
  secretaryCreated    Boolean           @default(false)
  guestPatientName    String?
  guestPatientPhone   String?
  payments            Payment[]
  reviews             DoctorReview[]
  cancellationRequests CancellationRequest[]
  clinicalHistory     ClinicalHistory?
  prescriptions       Prescription[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([patientId, status])
  @@index([doctorId, status])
}

model ClinicalHistory {
  id                        String      @id @default(cuid())
  doctorId                  String
  doctor                    Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId                 String
  patient                   Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId             String      @unique
  appointment               Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  identificationCard        String?     @db.Text
  ethnicGroup               String?     @db.Text
  consultationReason        String?     @db.Text
  hereditaryFamilyHistory   String?     @db.Text
  nonPathologicalHistory    String?     @db.Text
  pathologicalHistory       String?     @db.Text
  surgicalHistory           String?     @db.Text
  fractureHistory           String?     @db.Text
  gynecoObstetricHistory    String?     @db.Text
  currentCondition          String?     @db.Text
  systemsReview             String?     @db.Text
  physicalExam              String?     @db.Text
  labsAndImaging            String?     @db.Text
  diagnosis                 String?     @db.Text
  treatment                 String?     @db.Text
  diagnosesOrClinicalProblems String?   @db.Text
  therapeuticIndication     String?     @db.Text
  plan                      String?     @db.Text
  prognosis                 String?     @db.Text
  healthStatus              String?     @db.Text
  additionalMedicalNotes    String?     @db.Text
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  @@unique([doctorId, patientId, appointmentId])
  @@index([doctorId, patientId])
}

model PrescriptionTemplate {
  id                  String         @id @default(cuid())
  doctorId            String         @unique
  doctor              Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  doctorName          String
  specialty           String
  professionalLicense String?
  phone               String?
  officeAddress       String?
  headerImageUrl      String?
  signatureImageUrl   String?
  prescriptions       Prescription[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model Prescription {
  id                     String                @id @default(cuid())
  doctorId               String
  doctor                 Doctor                @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId              String
  patient                Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId          String
  appointment            Appointment           @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  templateId             String?
  template               PrescriptionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  patientAge             String?
  diagnosis              String?               @db.Text
  medicationInstructions String?               @db.Text
  dosage                 String?               @db.Text
  frequency              String?               @db.Text
  duration               String?               @db.Text
  generalRecommendations String?               @db.Text
  additionalNotes        String?               @db.Text
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([doctorId, patientId])
  @@index([appointmentId])
}

model Payment {
  id                      String          @id @default(cuid())
  appointmentId           String
  appointment             Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  provider                PaymentProvider
  providerPaymentIntentId String?
  providerChargeId        String?
  providerCheckoutSessionId String?
  doctorId                String?
  amountCents             Int
  currency                String          @default("mxn")
  status                  PaymentStatus   @default(PENDING)
  transferStatus          String?
  refundId                String?
  refundedAt              DateTime?
  refundedAmountCents     Int?
  receiptUrl              String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([appointmentId, status])
  @@index([providerCheckoutSessionId])
  @@index([doctorId, status])
}

model CancellationRequest {
  id            String      @id @default(cuid())
  appointmentId String
  appointment  Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  reason        String
  status        String      @default("pendiente")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([appointmentId, status])
  @@index([doctorId, status, createdAt])
  @@index([patientId, status, createdAt])
}

model MedicalVerification {
  id                  String             @id @default(cuid())
  doctorId            String             @unique
  doctor              Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  professionalLicense String
  specialtyBoard      String?
  documentUrls        String[]
  status              VerificationStatus @default(IN_REVIEW)
  reviewedByUserId    String?
  reviewedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model DoctorReview {
  id            String       @id @default(cuid())
  doctorId      String
  doctor        Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  rating        Int
  comment       String
  doctorReply   String?
  status        ReviewStatus @default(PUBLISHED)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([appointmentId])
  @@index([doctorId, status, createdAt])
  @@index([patientId, createdAt])
}

model MedicalConversation {
  id                String                    @id @default(cuid())
  title             String
  status            MedicalConversationStatus @default(OPEN)
  createdByDoctorId String
  createdByDoctor   Doctor                    @relation("ConversationCreator", fields: [createdByDoctorId], references: [id], onDelete: Cascade)
  recipientDoctorId String?
  recipientDoctor   Doctor?                   @relation("ConversationRecipient", fields: [recipientDoctorId], references: [id], onDelete: SetNull)
  patientAlias      String?
  clinicalSummary   String?
  messages          MedicalChatMessage[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([createdByDoctorId, createdAt])
  @@index([recipientDoctorId, createdAt])
}

model MedicalChatMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   MedicalConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   String?
  sender         User?               @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  body           String
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
  @@index([senderUserId, createdAt])
}

model MedicationSearchLog {
  id        String   @id @default(cuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  query     String
  source    String
  createdAt DateTime @default(now())

  @@index([doctorId, createdAt])
}

model MarketplaceListing {
  id                     String                        @id @default(cuid())
  userId                 String?                       @unique
  user                   User?                         @relation(fields: [userId], references: [id], onDelete: SetNull)
  type                   MarketplaceListingType
  name                   String
  description            String                        @db.Text
  cityOrZone             String
  priceRange             String?
  contactName            String?
  phone                  String?
  email                  String?
  imageUrl               String?
  status                 MarketplaceListingStatus      @default(PENDING)
  plan                   MarketplacePlan               @default(obsidiana)
  subscriptionStatus     MarketplaceSubscriptionStatus @default(PENDING)
  providerCustomerId     String?
  providerSubscriptionId String?
  providerSessionId      String?
  activeUntil            DateTime?
  payments               MarketplaceSubscriptionPayment[]
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  @@unique([type, name, cityOrZone])
  @@index([userId])
  @@index([type, status, subscriptionStatus, createdAt])
  @@index([providerSubscriptionId])
}

model MarketplaceSubscriptionPayment {
  id                     String              @id @default(cuid())
  listingId              String
  listing                MarketplaceListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  plan                   MarketplacePlan     @default(obsidiana)
  amountCents            Int                 @default(0)
  currency               String              @default("mxn")
  status                 PaymentStatus       @default(PENDING)
  provider               PaymentProvider     @default(STRIPE)
  providerSessionId      String?
  providerPaymentId      String?
  providerCustomerId     String?
  providerSubscriptionId String?
  currentPeriodEnd       DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([listingId, status, createdAt])
  @@index([providerSessionId])
  @@index([providerCustomerId])
  @@index([providerSubscriptionId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String?
  entityId    String?
  ipAddress   String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

/// Vincula una cuenta ASSISTANT a su médico empleador.
/// Un doctor puede tener hasta un asistente activo; un asistente pertenece a un solo médico.
model DoctorAssistant {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([doctorId])
}

/// Enlace de secretaría — permite que la recepcionista registre citas sin necesitar cuenta VITAEON.
/// El token es un UUID opaco generado por el médico. El PIN se guarda como hash bcrypt.
model DoctorSecretaryLink {
  id        String   @id @default(cuid())
  doctorId  String   @unique
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  token     String   @unique
  pinHash   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
