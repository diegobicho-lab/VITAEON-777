# =========================
# App
# =========================
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETA_ALLOW_INDEXING="false"

# =========================
# Database
# =========================
# Production: usar URL directa (port 5432, sin pgbouncer=true) para migraciones.
# Runtime: usar la URL de pooler (port 6543, pgbouncer=true) es seguro.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vitaeon?schema=public"

# =========================
# Auth
# =========================
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-strong-32-byte-secret"
SEED_ADMIN_EMAIL="admin@vitaeon.mx"
SEED_ADMIN_PASSWORD="replace-with-a-strong-temporary-admin-password"

# =========================
# PHI Encryption
# =========================
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CRÍTICO: 32 bytes exactos en base64. Verifica con:
# node -e "const k=Buffer.from(process.env.ENCRYPTION_KEY,'base64');console.log(k.length,'bytes')"
ENCRYPTION_KEY="base64-encoded-32-byte-key"

# =========================
# Stripe
# =========================
STRIPE_SECRET_KEY="sk_test_replace_me"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
# Obtenido desde Stripe Dashboard → Developers → Webhooks → tu endpoint
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_PLATFORM_FEE_PERCENTAGE="0"
VITAEON_PLATFORM_OWNER_REF="vitaeon-primary-stripe-account"

# =========================
# Cron Jobs (Vercel)
# =========================
# REQUERIDO. Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Debe coincidir con el valor configurado en Vercel → Settings → Environment Variables.
# Sin este valor, los endpoints /api/cron/* devuelven 401 y no se ejecutan.
CRON_SECRET="replace-with-a-strong-random-secret"

# =========================
# Email — Resend (proveedor primario)
# =========================
# Obtener en: https://resend.com → API Keys
# Si se omite, el sistema intenta SMTP como fallback. Si ambos fallan, los emails no se envían.
RESEND_API_KEY="re_replace_me"

# =========================
# Email — SMTP (fallback si RESEND_API_KEY no está configurado)
# =========================
EMAIL_FROM="VITAEON <no-reply@vitaeon.mx>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
SMTP_STARTTLS="true"
# Hostname enviado en el comando EHLO/EHLO STARTTLS.
# Si se omite, se deriva de APP_URL (recomendado). Solo configura si tu SMTP rechaza el dominio derivado.
EMAIL_EHLO_HOSTNAME=""

# =========================
# IA — Anthropic (asistente médico virtual, solo plan Amatista)
# =========================
# Obtener en: https://console.anthropic.com → API Keys
# Sin este valor, el asistente IA usa respuestas de fallback (sin IA real).
ANTHROPIC_API_KEY="sk-ant-replace_me"

# =========================
# Rate Limiting — Upstash Redis
# =========================
# REQUERIDO para rate limiting en producción.
# Sin estas variables el rate limiting está DESACTIVADO, dejando los endpoints de auth expuestos.
# Obtener en: https://console.upstash.com → Redis → tu instancia → REST API
UPSTASH_REDIS_REST_URL="https://replace-me.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-token"

# =========================
# Storage — Supabase
# =========================
STORAGE_PROVIDER="supabase"
STORAGE_BUCKET="vitaeon-verifications"
STORAGE_PRIVATE_BASE_PATH="doctor-profile-assets"
SUPABASE_URL="https://replace-me.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"

# =========================
# Medication API (opcional)
# =========================
MEDICATION_API_URL=""
MEDICATION_API_KEY=""

# =========================
# Campañas de afiliados
# =========================
# Código de campaña para el médico afiliado específico.
# NUNCA debe quedar con valor real en repositorios públicos.
# Configura cada código en Vercel como variable de entorno.
SUSANA_AFFILIATE_CODE=""

# =========================
# Admin
# =========================
ADMIN_MFA_REQUIRED="false"
